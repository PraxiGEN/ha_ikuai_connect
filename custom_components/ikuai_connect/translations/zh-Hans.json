        "state_attributes": {
          "protocol": { "name": "拨号协议" },
          "ipv4": { "name": "IPv4 地址" },
          "gateway": { "name": "网关地址" },
          "auto_switch": { "name": "自动切换" },
          "errmsg": { "name": "错误信息" },
          "parent_interface": { "name": "所属父接口" }
        }
      },
      "wan_ipv4_addr": { "name": "{iface} IPv4 地址" },
      "wan_v6_upload_speed": { "name": "{iface} IPv6 上传速度" },
      "wan_v6_download_speed": { "name": "{iface} IPv6 下载速度" },
      "wan_v6_total_up": { "name": "{iface} IPv6 累计上传" },
      "wan_v6_total_down": { "name": "{iface} IPv6 累计下载" },
      "wan_v6_conn": { "name": "{iface} IPv6 连接数" },
      "wan_balance_snapshot": {
        "name": "多 WAN 负载均衡快照",
        "state_attributes": {
          "lines": { "name": "各线路详情" }
        }
      },
      "upgrade_status": { 
        "name": "固件更新状态",
        "state_attributes": {
          "upgrade_detail": { "name": "更新详情" }
        }
      },
      "firmware_version": {
        "name": "版本固件",
        "state_attributes": {
          "version": { "name": "当前版本" },
          "verstring": { "name": "完整版本号" },
          "modelname": { "name": "机型名称" },
          "build_date": { "name": "编译日期" },
          "arch": { "name": "处理器架构" },
          "sysbit": { "name": "系统位数" }
        }
      },
      "latest_backup": { 
        "name": "最后备份文件", 
        "state_attributes": {
          "detail": { "name": "备份详情" }
        }
      },      
      "disk_total_capacity": { 
        "name": "物理总容量",
        "state_attributes": {
          "base_info": { "name": "磁盘基础信息" }
        }
      },  
      "disk_usage_rate": { "name": "综合使用率" },
      "disk_used_capacity": { 
        "name": "已用总容量",
        "state_attributes": {
          "partitions": { "name": "分区使用详情" }
        }
      }
    },
    "button": {
      "reboot": { "name": "重启路由器" },
      "check_update": { "name": "检查固件更新" },
      "start_upgrade": { "name": "开始固件升级" },
      "create_backup": { "name": "立即备份系统配置" }
    },
    "event": { 
      "message_center": { "name": "系统消息通知" },
      "terminal_presence_log": { 
        "name": "终端上下线记录",
        "state_attributes": {
          "mac": { "name": "MAC 地址" },
          "ip": { "name": "IP 地址" },
          "action": {
            "name": "状态",
            "state": {
              "online": "上线",
              "offline": "下线"            
            }
          },
          "online_time": { "name": "在线时长 (秒)" },
          "today_total": { "name": "今日总计" },
          "os": { "name": "操作系统" },
          "vendor": { "name": "生产商" },
          "model": { "name": "设备型号" },
          "id": { "name": "ID" },
          "timestamp": { "name": "记录时间" }     
        }
      },  
      "dynamic_ddns_log": { 
        "name": "动态域名变更记录",       
        "state_attributes": {
          "domain": { "name": "域名" },
          "status": { "name": "状态" },
          "message": { "name": "日志详情" },
          "ip": {"name": "IP 地址"},
          "mac": { "name": "MAC 地址" },
          "id": { "name": "ID" },
          "time": { "name": "记录时间" }
        }
      },
      "wireless_terminal_log": { 
        "name": "无线终端变更记录",     
        "state_attributes": {
          "mac": { "name": "MAC 地址" },
          "ssid": { "name": "SSID" },
          "signal": { "name": "信号强度" },
          "ap_mac": { "name": "连接的 AP MAC 地址" },
          "ap_name": { "name": "接入点" },
          "action":{ "name": "事件", "state":{ "login": "登录", "logout": "退出" }},
          "reason": { "name": "状态" },
          "time": { "name": "记录时间" }
        }
      },
      "system_log": {
        "name": "系统日志记录",
        "state_attributes": {
          "content": { "name": "日志内容" },
          "level": { "name": "级别" },
          "module": { "name": "模块" },
          "process": { "name": "进程" },
          "id": { "name": "ID" },
          "timestamp": { "name": "记录时间" }
        }
      }
    },
    "select": {
      "mac_acl_mode": { 
        "name": "全局访问控制模式",
        "state": {
          "whitelist": "白名单模式 (放行模式)",
          "blacklist": "黑名单模式 (阻断模式)"
        }
      }
    },
    "switch": {
      "mac_rule": {
        "name": "MAC 访问控制",
        "state_attributes": {
          "mac_address": { "name": "MAC 地址" },
          "terminal_name": { "name": "终端名称" },
          "comment": { "name": "备注信息" },
          "schedule": { 
            "name": "生效时间",
            "state": {
              "every_week": "每周",
              "specific_date": "特定日期",
              "all_day": "全天"
            }
          },
          "expires": { 
            "name": "过期时间",
            "state": {
              "permanent": "永久"
            }
          },
          "rule_id": { "name": "规则 ID" }
        }
      }
    },  
    "device_tracker": {
      "ikuai_tracker": { 
        "name": "终端追踪",
        "state_attributes": {
          "mac_address": { "name": "MAC 地址" },
          "ip_address": { "name": "IP 地址" },
          "ap_mac": { "name": "连接的 AP MAC 地址" },
          "uplink_addr": { "name": "上行地址" }
        }
      }
    }
  },
  "services": {
    "reboot": {
      "name": "重启路由器",
      "description": "重启指令已下发，爱快将在 1 分钟内执行重启。"
    },
    "check_upgrade": {
      "name": "检测更新",
      "description": "正在向云端检测新版本，请稍候查看系统日志。"
    },
    "start_upgrade": {
      "name": "固件升级",
      "description": "系统升级指令已触发，请勿断电或重启设备。"
    },
    "backup": {
      "name": "系统备份",
      "description": "系统备份任务已开始，请稍候在后台查看备份文件。"
    },
    "get_traffic_ranking": {
      "name": "获取当日流量排行",
      "description": "查询所有终端今天的流量使用情况汇总，单位为 MB。",
      "fields": {
        "device_id": {
          "name": "目标设备",
          "description": "选择要查询的路由器设备。仅配置了多台路由器时需要指定。"
        }
      }
    },
    "get_protocol_stats": {
      "name": "获取设备协议分布",
      "description": "查询指定终端最近 24 小时的协议分类流量统计（例如判断设备是在看视频还是下文件）。",
      "fields": {
        "device_id": {
          "name": "目标设备",
          "description": "选择要查询的路由器设备。仅配置了多台路由器时需要指定。"
        },
        "mac": {
          "name": "MAC 地址",
          "description": "终端的 MAC 地址。"
        },
        "ip": {
          "name": "IP 地址",
          "description": "终端的 IP 地址（可选，不填则尝试从缓存自动匹配）。"
        }
      }
    },
    "get_offline_history": {
      "name": "获取离线终端历史",
      "description": "查询最近 20 条终端下线记录，单位为 MB。",
      "fields": {
        "device_id": {
          "name": "目标设备",
          "description": "选择要查询的路由器设备。仅配置了多台路由器时需要指定。"
        }
      }
    },
    "add_mac_rule": {
      "name": "添加 MAC 访问控制规则",
      "description": "在爱快中创建一条新的 MAC 黑/白名单规则。创建后集成会自动生成对应的开关实体。",
      "fields": {
        "device_id": {
          "name": "目标设备",
          "description": "选择要操作的路由器设备。仅配置了多台路由器时需要指定。"
        },
        "mac": {
          "name": "MAC 地址",
          "description": "终端的物理地址。"
        },
        "tagname": {
          "name": "规则名称",
          "description": "显示在爱快后台和 HA 实名中的名称。"
        },
        "expires": {
          "name": "过期时间戳",
          "description": "Unix 时间戳。到期后规则自动失效。0 为永不过期。"
        }
      }
    },
    "delete_mac_rule": {
      "name": "删除 MAC 访问控制规则",
      "description": "彻底移除指定的 MAC 过滤规则。对应的 HA 开关实体将自动注销。",
      "fields": {
        "device_id": {
          "name": "目标设备",
          "description": "选择要操作的路由器设备。仅配置了多台路由器时需要指定。"
        },
        "rule_id": {
          "name": "规则 ID",
          "description": "规则的唯一数字 ID（可从实体属性中查看）。"
        }
      }
    },
    "call_api_service": {
      "name": "自定义 API 调用",
      "description": "通用调用爱快路由器任意 OpenAPI 接口，用于获取尚未原生接入的数据或执行操作。",
      "fields": {
        "device_id": {
          "name": "目标设备",
          "description": "选择要操作的路由器设备。仅配置了多台路由器时需要指定。"
        },
        "path": {
          "name": "接口路径",
          "description": "以 /api/ 开头的接口路径，例如 /api/v4.0/monitoring/clients-online"
        },
        "method": {
          "name": "请求方法",
          "description": "HTTP 请求方法（下拉选择）。GET 用于获取数据，参数拼接到 URL 查询串；POST/PUT/DELETE 用于提交数据或执行操作，参数作为请求体发送。默认 GET。"
        },
        "params": {
          "name": "请求参数 (JSON)",
          "description": "JSON 格式的参数。GET 会拼接到查询串，POST/PUT/DELETE 作为请求体。"
        },
        "timeout": {
          "name": "超时 (秒)",
          "description": "请求超时时间，默认 15 秒，最大 120。"
        },
        "return_raw": {
          "name": "返回原始响应",
          "description": "开启后 data 字段返回包含 code/message/results 的完整响应；关闭则只返回业务数据(results)。"
        }
      }
    }
  }
}