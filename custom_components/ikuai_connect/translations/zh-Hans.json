      "temperature": { "name": "系统温度" },
      "ap_online": { 
        "name": "在线 AP 数量", 
        "state_attributes": {
          "wireless_detail": { "name": "无线详情" }
        }
      },
      "upload_speed": { "name": "{iface} 实时上传速度" },
      "download_speed": { "name": "{iface} 实时下载速度" },
      "total_up": { "name": "{iface} 累计上传流量" },
